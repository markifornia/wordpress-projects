
# ==========================================
# WordPress Projects - Git Ignore
# ==========================================

# Ignore everything at the repository root
/*

# ==========================================
# Repository Files
# ==========================================

!/.gitignore
!/README.md

# Allow the Embark project directory
!/wordpress-project-embark/

# Ignore everything inside Embark by default
/wordpress-project-embark/*

# ==========================================
# Embark - Docker Configuration
# ==========================================

!/wordpress-project-embark/compose.yml
!/wordpress-project-embark/Dockerfile
!/wordpress-project-embark/apache-security.conf

# ==========================================
# Embark - Custom WordPress Code
# ==========================================

# Allow wp-content
!/wordpress-project-embark/wp-content/

/wordpress-project-embark/wp-content/*

# Allow themes and plugins directories
!/wordpress-project-embark/wp-content/themes/
!/wordpress-project-embark/wp-content/plugins/

# Ignore installed themes and plugins
/wordpress-project-embark/wp-content/themes/*
/wordpress-project-embark/wp-content/plugins/*

# Track our custom theme
!/wordpress-project-embark/wp-content/themes/my-custom-theme/

# ==========================================
# Sensitive Files
# ==========================================

.env
.env.*
wp-config.php
wp-config-*.php

# ==========================================
# Generated Content
# ==========================================

**/wp-content/uploads/
**/wp-content/cache/
**/wp-content/upgrade/
**/wp-content/backups/
**/wp-content/ai1wm-backups/

# ==========================================
# Operating System / Editor Files
# ==========================================

.DS_Store
Thumbs.db
.vscode/
.idea/

# ==========================================
# Dependencies
# ==========================================

node_modules/
vendor/
