
{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#2563eb",
          "name": "Primary"
        },
        {
          "slug": "background",
          "color": "#ffffff",
          "name": "Background"
        },
        {
          "slug": "foreground",
          "color": "#111827",
          "name": "Foreground"
        },
        {
          "slug": "accent",
          "color": "#f97316",
          "name": "Accent"
        }
      ]
    },
    "typography": {
      "fluidTypography": true,
      "fontFamilies": [
        {
          "fontFamily": "Arial, Helvetica, sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        },
        {
          "fontFamily": "Georgia, 'Times New Roman', serif",
          "name": "Classic Serif",
          "slug": "classic-serif"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "14px"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "16px"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "24px"
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "36px"
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vh", "vw"],
      "spacingSizes": [
        {
          "name": "Extra Small",
          "slug": "xs",
          "size": "8px"
        },
        {
          "name": "Small",
          "slug": "sm",
          "size": "16px"
        },
        {
          "name": "Medium",
          "slug": "md",
          "size": "24px"
        },
        {
          "name": "Large",
          "slug": "lg",
          "size": "40px"
        },
        {
          "name": "Extra Large",
          "slug": "xl",
          "size": "64px"
        }
      ]
    },
    "border": {
      "radius": true,
      "color": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "name": "Subtle",
          "slug": "subtle",
          "shadow": "0 2px 4px rgba(0, 0, 0, 0.08)"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "shadow": "0 4px 12px rgba(0, 0, 0, 0.15)"
        },
        {
          "name": "Strong",
          "slug": "strong",
          "shadow": "0 8px 24px rgba(0, 0, 0, 0.25)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|background",
      "text": "var:preset|color|foreground"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system-sans",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|accent"
          }
        }
      },
      "h2": {
        "color": {
          "text": "var:preset|color|accent"
        },
        "typography": {
          "fontSize": "32px",
          "fontWeight": "700"
        }
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "8px"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "bottom": "12px",
            "left": "24px",
            "right": "24px"
          }
        },
        "typography": {
          "fontWeight": "600"
        },
        "variations": {
          "fill": {
            "color": {
              "background": "var:preset|color|primary",
              "text": "#ffffff"
            }
          },
          "outline": {
            "color": {
              "background": "transparent",
              "text": "var:preset|color|primary"
            },
            "border": {
              "color": "var:preset|color|primary",
              "width": "4px",
              "style": "solid"
            }
          }
        }
      }
    },
    "spacing": {
      "blockGap": "var:preset|spacing|md"
    }
  }
}
