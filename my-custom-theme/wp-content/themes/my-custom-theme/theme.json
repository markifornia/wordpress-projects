
{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#2563eb",
          "name": "Primary"
        },
        {
          "slug": "background",
          "color": "#ffffff",
          "name": "Background"
        },
        {
          "slug": "foreground",
          "color": "#111827",
          "name": "Foreground"
        },
        {
          "slug": "accent",
          "color": "#f97316",
          "name": "Accent"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|background",
      "text": "var:preset|color|foreground"
    },
    "elements": {
      "h2": {
        "color": {
          "text": "var:preset|color|accent"
        },
        "typography": {
          "fontSize": "32px",
          "fontWeight": "700"
        }
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "8px"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "bottom": "12px",
            "left": "24px",
            "right": "24px"
          }
        },
        "typography": {
          "fontWeight": "600"
        },
        "variations": {
          "fill": {
            "color": {
              "background": "var:preset|color|primary",
              "text": "#ffffff"
            }
          },
          "outline": {
            "color": {
              "background": "transparent",
              "text": "var:preset|color|primary"
            },
            "border": {
              "color": "var:preset|color|primary",
              "width": "4px",
              "style": "solid"
            }
          }
        }
      }
    }
  }
}
